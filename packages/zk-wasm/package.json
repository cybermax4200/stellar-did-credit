{
  "name": "@stellar-did-credit/zk-wasm",
  "version": "0.1.0",
  "description": "WASM prover for Stellar DID credit score proofs, with a Web Worker wrapper",
  "main": "pkg/zk_wasm.js",
  "types": "pkg/zk_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/zk_wasm.d.ts",
      "default": "./pkg/zk_wasm.js"
    },
    "./worker": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker-script": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "pkg",
    "pkg-web",
    "dist"
  ],
  "scripts": {
    "build": "wasm-pack build --release --target nodejs",
    "build:web": "wasm-pack build --release --target web --out-dir pkg-web",
    "build:ts": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && node -e \"require('fs').writeFileSync('dist/package.json', '{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "build:all": "pnpm run build && pnpm run build:web && pnpm run build:ts",
    "test": "pnpm run build:ts && node --test dist/index.test.js",
    "test:build": "node test/compare-builds.cjs",
    "test:browser": "node test/browser-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.0.0"
  }
}
