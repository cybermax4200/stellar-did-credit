# ---------------------------------------------------------------------------
# Required — feeder will not start without these
# ---------------------------------------------------------------------------

# Stellar secret key of the feeder account (S...).
# Must be registered on-chain first: register_feeder(admin, FEEDER_PUBLIC_KEY)
FEEDER_SECRET=YOUR_STELLAR_SECRET_KEY

# Comma-separated list of subject G... addresses to sync each cycle
SUBJECTS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# credit-oracle contract address (C...)
CREDIT_ORACLE_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# identity-oracle contract address (C...)
IDENTITY_ORACLE_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# revocation-registry contract address (C...)
# OPTIONAL — required for event-driven mode so the feeder can watch for
# `Revoked` events and re-sync affected subjects. When set it is validated
# as a Soroban contract address at startup. Leave blank to disable.
REVOCATION_REGISTRY_ID=

# governance contract address (C...)
# OPTIONAL — reserved for future governance-aware features. The feeder does
# not call governance today; setting this only records the contract for
# later use. When set it is validated as a Soroban contract address.
GOVERNANCE_ID=

# ---------------------------------------------------------------------------
# Network Configuration
# ---------------------------------------------------------------------------

# Network to use: testnet (default), mainnet, or futurenet
# This sets defaults for NETWORK_PASSPHRASE, RPC_URL, HORIZON_URL, and SIM_ACCOUNT
NETWORK=testnet

# ---------------------------------------------------------------------------
# Optional — defaults shown are for Stellar testnet
# Override these to use custom endpoints or when NETWORK=mainnet
# ---------------------------------------------------------------------------

# Network passphrase
# Testnet: Test SDF Network ; September 2015
# Mainnet: Public Global Stellar Network ; September 2015  
# Futurenet: Test SDF Future Network ; October 2022
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.mainnet.stellarchain.io
# Futurenet: https://rpc-futurenet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Horizon REST API endpoint  
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
# Futurenet: https://horizon-futurenet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Any funded account used as fee source for read-only contract simulations
# REQUIRED for mainnet operations - must be a funded mainnet account
# Testnet/Futurenet: GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
SIM_ACCOUNT=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# How often to run a full feed cycle, in milliseconds (default: 1 hour)
POLL_INTERVAL_MS=3600000

# Max retry attempts for transient RPC/Horizon failures (default: 3)
MAX_RETRIES=3

# Base delay for exponential backoff, in milliseconds (default: 1000)
RETRY_BASE_DELAY_MS=1000

# ---------------------------------------------------------------------------
# Health monitoring (optional)
# ---------------------------------------------------------------------------

# When set, starts an HTTP server on this port exposing GET /health and GET /ready
# for container orchestrator liveness/readiness probes. Uses Node's built-in http
# module — no extra dependencies required.
# HEALTH_PORT=8080

# ---------------------------------------------------------------------------  
# Mainnet Example Configuration
# ---------------------------------------------------------------------------
# Uncomment and configure for mainnet deployment:
#
# NETWORK=mainnet
# CREDIT_ORACLE_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# IDENTITY_ORACLE_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  
# SIM_ACCOUNT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# FEEDER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# SUBJECTS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
